{
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "blog.start-ing.kr" }],
      "destination": "https://blog.starting.kr/",
      "statusCode": 301
    },
    { "source": "/recruiting-partner", "destination": "/", "permanent": true },
    { "source": "/project", "destination": "/", "permanent": true },
    { "source": "/faq", "destination": "/", "permanent": true },
    {
      "source": "/:path((?!.*\\..*)(?!company(?:/|$)|api(?:/|$)|parts(?:/|$)|integrations(?:/|$)|uploads(?:/|$)|assets(?:/|$)).+)",
      "destination": "/",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/company", "destination": "/company/index.html" },
    { "source": "/company/:path*", "destination": "/company/index.html" }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Methods", "value": "POST, OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type" }
      ]
    }
  ]
}
